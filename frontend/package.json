    "dayjs": "^1.11.13"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vite": "^6.2.0",
    "@vitejs/plugin-react": "^4.3.0",
    "sass": "^1.85.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "vitest": "^3.0.0",
    "prettier": "^3.9.10"
  }
}
